# CivicPulse Self-Managed Environment Configuration
# ==============================================================================
# ZERO MANDATORY ENVIRONMENT VARIABLES:
# The application runs 100% self-managed out of the box without requiring any
# environment variables. All security, storage, database, AI, and networking
# defaults are handled automatically by the application runtime.
# ==============================================================================

# [OPTIONAL OVERRIDES - All have automatic self-contained defaults]
#
# Override HTTP port (defaults to 3000):
# PORT=3000
#
# Override JWT Signing Secret (if omitted, a cryptographically secure 256-bit
# random secret is automatically generated and safely persisted to data/.jwt_secret):
# JWT_SECRET=
#
# Override Local Database URL (defaults to sqlite:///./data/civicpulse.db):
# DATABASE_URL=sqlite:///./data/civicpulse.db
#
# Override Storage Directories (automatically created if omitted):
# DATA_DIR=./data
# DATABASE_FILE=./data/civic_store.json
# UPLOAD_DIR=./uploads
#
# Override AI Engine mode (defaults to local_self_managed):
# AI_ENGINE=local_self_managed
#
# Reverse Proxy & CORS Options (defaults to trusted proxy and universal origin):
# TRUST_PROXY=true
# ALLOWED_ORIGINS=*
